---
const { size = 30, withWordmark = true } = Astro.props;
---

<span class="logo">
  <svg
    width={size}
    height={size}
    viewBox="0 0 32 32"
    fill="none"
    aria-label="BitsServer IT Lab"
    role="img"
  >
    <path d="M16 2.2 28.6 9.1v13.8L16 29.8 3.4 22.9V9.1L16 2.2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" opacity="0.55"></path>
    <path d="M16 8.4 23.2 12.3v7.4L16 23.6l-7.2-3.9v-7.4L16 8.4Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
    <circle cx="16" cy="16" r="2.4" fill="currentColor"></circle>
    <path d="M16 2.2v6.2M28.6 9.1 23.2 12.3M28.6 22.9 23.2 19.7M16 29.8v-6.2M3.4 22.9l5.4-3.2M3.4 9.1l5.4 3.2" stroke="currentColor" stroke-width="1.2" opacity="0.5"></path>
  </svg>
  {withWordmark && (
    <span class="logo__text">
      <b>Bits</b>Server<span class="logo__dot">.</span>
    </span>
  )}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--signal);
  }
  .logo__text {
    font-family: var(--font-display);
    font-size: 1.12rem;
    font-weight: 500;
    letter-spacing: -0.035em;
    color: var(--ink);
  }
  .logo__text b {
    font-weight: 800;
  }
  .logo__dot {
    color: var(--signal);
  }
</style>
