---
const stats = [
  { n: '480+', l: 'Projects delivered' },
  { n: '320+', l: 'Happy clients' },
  { n: '24', l: 'Countries served' },
  { n: '99.9%', l: 'Uptime SLA' },
];
---

<section class="hero" id="top">
  <div class="hero__still" aria-hidden="true"></div>
  <canvas class="hero__canvas" id="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__scan" aria-hidden="true"></div>

  <div class="wrap hero__content">
    <span class="eyebrow">Multan · Abu Dhabi<span class="hide-sm"> · Deployed worldwide</span></span>

    <h1 class="hero__title">
      <span class="line">Building the future with</span>
      <span class="line grad">AI, Cloud &amp; Digital</span>
      <span class="line">Innovation.</span>
    </h1>

    <p class="lede hero__lede">
      Full-stack IT solutions engineered for speed, security and scale — from intelligent automation
      and NVMe cloud infrastructure to zero-trust security and products that ship.
    </p>

    <div class="hero__actions">
      <a href="#contact" class="btn btn--primary">
        Start a project
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
      <a href="#services" class="btn btn--ghost">Explore capabilities</a>
    </div>

    <dl class="hero__stats">
      {
        stats.map((s) => (
          <div class="stat">
            <dt class="stat__n" data-count={s.n}>{s.n}</dt>
            <dd class="stat__l">{s.l}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <div class="hero__hint mono" aria-hidden="true">
    <span>scroll</span>
    <span class="hero__line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: clamp(7rem, 14vh, 9.5rem) clamp(3rem, 8vh, 5rem);
    isolation: isolate;
    overflow: hidden;
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    opacity: 0;
    transition: opacity 0.8s var(--ease);
  }
  .hero__canvas.is-live {
    opacity: 1;
  }

  /* ---------------------------------------------------------------
     Static substrate. Painted by CSS on every device, and used as the
     only hero backdrop on phones, low-power hardware, metered data and
     reduced-motion — where the WebGL scene is never loaded at all.
     --------------------------------------------------------------- */
  .hero__still {
    position: absolute;
    inset: 0;
    z-index: -3;
    background:
      radial-gradient(ellipse 58% 44% at 50% 88%, rgba(60, 231, 196, 0.2), transparent 68%),
      radial-gradient(ellipse 44% 38% at 82% 22%, rgba(139, 108, 255, 0.18), transparent 70%),
      radial-gradient(ellipse 70% 50% at 12% 34%, rgba(26, 169, 141, 0.12), transparent 72%),
      linear-gradient(180deg, #060b16 0%, #04070d 62%, var(--bg) 100%);
  }
  /* Perspective floor grid — the flavour of the 3D rack field, in pure CSS. */
  .hero__still::after {
    content: '';
    position: absolute;
    inset: 42% 0 0;
    background-image:
      linear-gradient(to right, rgba(60, 231, 196, 0.16) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(60, 231, 196, 0.16) 1px, transparent 1px);
    background-size: 46px 46px;
    transform: perspective(340px) rotateX(64deg);
    transform-origin: 50% 0;
    mask-image: linear-gradient(180deg, transparent, #000 22%, transparent 82%);
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 22%, transparent 82%);
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 70% 55% at 18% 78%, rgba(4, 7, 13, 0.94), transparent 70%),
      linear-gradient(180deg, rgba(4, 7, 13, 0.86) 0%, rgba(4, 7, 13, 0.18) 34%, rgba(4, 7, 13, 0.6) 76%, var(--bg) 100%);
  }
  .hero__scan {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: repeating-linear-gradient(180deg, rgba(255, 255, 255, 0.018) 0 1px, transparent 1px 4px);
    mix-blend-mode: overlay;
    pointer-events: none;
  }

  .hero__content {
    width: 100%;
  }
  @media (max-width: 620px) {
    .hide-sm {
      display: none;
    }
  }
  .hero__title {
    font-size: var(--text-hero);
    margin: 1.1rem 0 1.4rem;
    max-width: 17ch;
  }
  .line {
    display: block;
    opacity: 0;
    transform: translate3d(0, 0.5em, 0);
    animation: rise 1.05s var(--ease) forwards;
  }
  .line:nth-child(2) {
    animation-delay: 0.12s;
  }
  .line:nth-child(3) {
    animation-delay: 0.24s;
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }
  .grad {
    background: linear-gradient(100deg, var(--signal) 0%, #9ff3e2 38%, var(--violet) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero__lede {
    animation: rise 1.05s 0.36s var(--ease) both;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2.1rem;
    animation: rise 1.05s 0.46s var(--ease) both;
  }

  .hero__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin: 3.6rem 0 0;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    animation: rise 1.05s 0.58s var(--ease) both;
    backdrop-filter: blur(8px);
  }
  .stat {
    background: rgba(7, 11, 20, 0.55);
    padding: 1.15rem 1.25rem;
  }
  .stat__n {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1rem + 1.6vw, 2.1rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--ink);
    margin: 0;
  }
  .stat__l {
    margin: 0.1rem 0 0;
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .hero__hint {
    position: absolute;
    right: clamp(1.25rem, 4vw, 2.5rem);
    bottom: 2.4rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ink-3);
  }
  .hero__line {
    display: block;
    width: 54px;
    height: 1px;
    background: linear-gradient(90deg, var(--ink-3), transparent);
    position: relative;
    overflow: hidden;
  }
  .hero__line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--signal);
    transform: translateX(-100%);
    animation: sweep 2.2s var(--ease) infinite;
  }
  @keyframes sweep {
    50%,
    100% {
      transform: translateX(100%);
    }
  }

  @media (max-width: 860px) {
    .hero__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hero__hint {
      display: none;
    }
    .hero__title {
      max-width: 100%;
    }
    .hero__still::after {
      inset: 62% 0 0;
      background-size: 34px 34px;
    }
    .hero__scrim {
      background:
        radial-gradient(ellipse 120% 55% at 50% 62%, rgba(4, 7, 13, 0.92), transparent 78%),
        linear-gradient(180deg, rgba(4, 7, 13, 0.9) 0%, rgba(4, 7, 13, 0.55) 30%, rgba(4, 7, 13, 0.8) 72%, var(--bg) 100%);
    }
  }

  /* The heavy scrim exists to keep text legible over a busy 3D render. With
     the static backdrop it only needs to be a light veil. */
  .hero.no-webgl .hero__scrim {
    background: linear-gradient(
      180deg,
      rgba(4, 7, 13, 0.62) 0%,
      rgba(4, 7, 13, 0.18) 34%,
      rgba(4, 7, 13, 0.55) 78%,
      var(--bg) 100%
    );
  }
</style>

<script>
  import { deviceTier, onFirstIntent } from '../scripts/scene-gate.js';

  const canvas = document.getElementById('hero-canvas');
  const hero = document.querySelector('.hero');
  const tier = deviceTier();

  if (!canvas || tier === 'off') {
    // Phones, low-power hardware, metered data, reduced motion: the Three.js
    // chunk is never requested. The CSS hero is the finished design.
    canvas?.remove();
    hero?.classList.add('no-webgl');
  } else {
    // Capable desktop. Download + build the scene on the first real gesture so
    // the ~1 s construction task never lands inside the page's load window.
    onFirstIntent(async () => {
      try {
        const { initHero } = await import('../scripts/hero3d.js');
        initHero(canvas, tier);
        canvas.classList.add('is-live');
      } catch (err) {
        console.warn('WebGL scene unavailable', err);
        canvas.remove();
        hero?.classList.add('no-webgl');
      }
    });
  }
</script>
