---
const services = [
  {
    k: '01',
    t: 'AI Solutions',
    d: 'Custom machine-learning models and intelligent automation that learns, adapts and cuts operating cost.',
    tags: ['ML models', 'Agents', 'RAG pipelines'],
    icon: 'ai',
  },
  {
    k: '02',
    t: 'Cloud Computing',
    d: 'Scalable AWS, Azure and GCP architectures with automated deployment and auto-scaling by default.',
    tags: ['AWS', 'Azure', 'GCP', 'IaC'],
    icon: 'cloud',
  },
  {
    k: '03',
    t: 'VPS Hosting',
    d: 'NVMe-backed virtual servers with a 99.9% uptime SLA and instant vertical scaling.',
    tags: ['NVMe', '99.9% SLA', 'Instant scale'],
    icon: 'server',
  },
  {
    k: '04',
    t: 'Web Development',
    d: 'Fast, SEO-optimised sites and web applications built on modern frameworks and edge runtimes.',
    tags: ['Astro', 'Next.js', 'Edge'],
    icon: 'web',
  },
  {
    k: '05',
    t: 'Mobile Apps',
    d: 'Native iOS and Android plus cross-platform builds with pixel-perfect interfaces.',
    tags: ['iOS', 'Android', 'Cross-platform'],
    icon: 'mobile',
  },
  {
    k: '06',
    t: 'Cybersecurity',
    d: 'Penetration testing, continuous threat monitoring and zero-trust architecture.',
    tags: ['Pen-testing', 'Zero-trust', 'SOC'],
    icon: 'shield',
  },
  {
    k: '07',
    t: 'Networking',
    d: 'Enterprise LAN and WAN design with hardened, secure remote-access infrastructure.',
    tags: ['LAN/WAN', 'VPN', 'SD-WAN'],
    icon: 'network',
  },
  {
    k: '08',
    t: 'IT Consulting',
    d: 'Strategic technology roadmaps and digital-transformation guidance tied to business outcomes.',
    tags: ['Roadmaps', 'Audits', 'Advisory'],
    icon: 'compass',
  },
];

const paths = {
  ai: 'M12 3v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.1 2.1m8.6 8.6 2.1 2.1m0-12.8-2.1 2.1M7.7 16.3l-2.1 2.1M12 8.6A3.4 3.4 0 1 0 12 15.4a3.4 3.4 0 0 0 0-6.8Z',
  cloud: 'M7 18h10a4 4 0 0 0 .6-7.95A6 6 0 0 0 6.1 9.2 3.9 3.9 0 0 0 7 18Z',
  server: 'M4 5h16v5H4V5Zm0 9h16v5H4v-5Zm3.5-6.5h.01M7.5 16.5h.01',
  web: 'M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18ZM21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  mobile: 'M8 3h8a1.5 1.5 0 0 1 1.5 1.5v15A1.5 1.5 0 0 1 16 21H8a1.5 1.5 0 0 1-1.5-1.5v-15A1.5 1.5 0 0 1 8 3Zm2.5 15h3',
  shield: 'M12 3 5 6v5.5c0 4.3 2.9 8.2 7 9.5 4.1-1.3 7-5.2 7-9.5V6l-7-3Zm-2.6 8.9 1.9 1.9 3.6-3.7',
  network: 'M12 3.5v4m0 9v4M4.5 8.2 8 10m8 4 3.5 1.8M19.5 8.2 16 10m-8 4-3.5 1.8M12 9.6a2.4 2.4 0 1 0 0 4.8 2.4 2.4 0 0 0 0-4.8ZM4 4.6a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm16 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM4 15.4a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm16 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z',
  compass: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm3.4 5.6-2 5.8-5.8 2 2-5.8 5.8-2Z',
};
---

<section class="section" id="services">
  <div class="wrap">
    <header class="sec-head" data-reveal>
      <span class="eyebrow">Capabilities</span>
      <h2 class="sec-title">Full-stack IT solutions,<br />engineered for scale.</h2>
      <p class="lede">
        Eight disciplines under one roof. One team owns the architecture, the build and the pager at
        3am — so nothing falls between vendors.
      </p>
    </header>

    <div class="cards" id="svc-cards">
      {
        services.map((s) => (
          <article class="card" data-tilt data-reveal>
            <div class="card__glow" aria-hidden="true"></div>
            <div class="card__inner">
              <div class="card__top">
                <span class="card__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" width="22" height="22">
                    <path
                      d={paths[s.icon]}
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
                <span class="card__k mono">{s.k}</span>
              </div>
              <h3 class="card__t">{s.t}</h3>
              <p class="card__d">{s.d}</p>
              <ul class="card__tags">
                {s.tags.map((tg) => (
                  <li>{tg}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .sec-head {
    max-width: 780px;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .sec-title {
    font-size: var(--text-2xl);
    margin: 1rem 0 1.1rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(272px, 1fr));
    gap: 1.1rem;
    perspective: 1200px;
  }

  .card {
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(165deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.012));
    padding: 1.6rem 1.5rem 1.5rem;
    overflow: hidden;
    transform-style: preserve-3d;
    transition: border-color 0.4s var(--ease), box-shadow 0.5s var(--ease), transform 0.35s var(--ease);
    will-change: transform;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(340px circle at var(--mx, 50%) var(--my, 0%), rgba(60, 231, 196, 0.14), transparent 62%);
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }
  .card:hover {
    border-color: rgba(60, 231, 196, 0.42);
    box-shadow: 0 28px 60px -34px rgba(60, 231, 196, 0.5);
  }
  .card:hover::before {
    opacity: 1;
  }
  .card__inner {
    position: relative;
    transform: translateZ(28px);
  }
  .card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.15rem;
  }
  .card__icon {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    color: var(--signal);
    background: rgba(60, 231, 196, 0.09);
    border: 1px solid rgba(60, 231, 196, 0.25);
  }
  .card__k {
    color: var(--ink-3);
    letter-spacing: 0.16em;
  }
  .card__t {
    font-size: var(--text-xl);
    margin-bottom: 0.55rem;
  }
  .card__d {
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 1.1rem 0 0;
  }
  .card__tags li {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
  }
</style>

<script>
  const cards = document.querySelectorAll('[data-tilt]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (!reduced && fine) {
    cards.forEach((card) => {
      let raf = 0;
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const px = (e.clientX - r.left) / r.width;
        const py = (e.clientY - r.top) / r.height;
        card.style.setProperty('--mx', `${px * 100}%`);
        card.style.setProperty('--my', `${py * 100}%`);
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          card.style.transform = `rotateY(${(px - 0.5) * 11}deg) rotateX(${(0.5 - py) * 11}deg) translateY(-6px) scale(1.015)`;
        });
      });
      card.addEventListener('pointerleave', () => {
        cancelAnimationFrame(raf);
        card.style.transform = '';
      });
    });
  }
</script>
