---
const offices = [
  { city: 'Multan, Pakistan', role: 'Headquarters', tz: 'UTC+5' },
  { city: 'Abu Dhabi, UAE', role: 'Zonal office', tz: 'UTC+4' },
];
---

<section class="section contact" id="contact">
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="wrap contact__grid">
    <div class="contact__copy">
      <span class="eyebrow" data-reveal>Let's build something exceptional</span>
      <h2 class="contact__title" data-reveal>Tell us about your project.</h2>
      <p class="lede" data-reveal>
        We usually reply within one business day — with a real engineer's opinion, not a sales deck.
      </p>

      <ul class="offices" data-reveal>
        {
          offices.map((o) => (
            <li>
              <span class="mono">{o.role}</span>
              <strong>{o.city}</strong>
              <em>{o.tz}</em>
            </li>
          ))
        }
      </ul>
    </div>

    <form class="form panel" id="contact-form" data-reveal novalidate>
      <div class="row">
        <label>
          <span>Name</span>
          <input type="text" name="name" required autocomplete="name" placeholder="Your name" />
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="email" required autocomplete="email" placeholder="you@company.com" />
        </label>
      </div>

      <label>
        <span>What do you need?</span>
        <select name="topic">
          <option>AI automation</option>
          <option>Cloud migration</option>
          <option>VPS hosting</option>
          <option>Web or mobile build</option>
          <option>Cybersecurity review</option>
          <option>Networking</option>
          <option>Something else</option>
        </select>
      </label>

      <label>
        <span>Project details</span>
        <textarea name="message" rows="4" required placeholder="Stack, timeline, what success looks like…"></textarea>
      </label>

      <button type="submit" class="btn btn--primary form__submit">
        <span class="form__label">Send enquiry</span>
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>

      <p class="form__note" id="form-note" role="status" aria-live="polite">
        Replies within one business day. No mailing list, ever.
      </p>
    </form>
  </div>
</section>

<style>
  .contact {
    position: relative;
    background: radial-gradient(ellipse 70% 60% at 50% 0%, rgba(60, 231, 196, 0.07), transparent 60%), var(--bg);
    overflow: hidden;
  }
  .contact__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .contact__title {
    font-size: var(--text-2xl);
    margin: 1rem 0 1.1rem;
  }

  .offices {
    list-style: none;
    padding: 0;
    margin: 2.4rem 0 0;
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .offices li {
    background: var(--bg-1);
    padding: 1rem 1.2rem;
    display: grid;
  }
  .offices strong {
    font-size: var(--text-lg);
    letter-spacing: -0.015em;
  }
  .offices em {
    font-style: normal;
    font-size: var(--text-xs);
    color: var(--ink-3);
  }

  .form {
    padding: clamp(1.4rem, 3vw, 2rem);
    display: grid;
    gap: 1rem;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  label {
    display: grid;
    gap: 0.4rem;
  }
  label > span {
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  input,
  select,
  textarea {
    font-family: inherit;
    font-size: var(--text-sm);
    color: var(--ink);
    background: rgba(4, 7, 13, 0.6);
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    padding: 0.75rem 0.9rem;
    transition: border-color 0.25s, box-shadow 0.25s;
    width: 100%;
  }
  textarea {
    resize: vertical;
    min-height: 110px;
  }
  input::placeholder,
  textarea::placeholder {
    color: #52627d;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--signal);
    box-shadow: 0 0 0 3px rgba(60, 231, 196, 0.12);
  }
  input[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-color: #ff7a7a;
  }
  .form__submit {
    justify-content: center;
    margin-top: 0.3rem;
  }
  .form__note {
    font-size: var(--text-xs);
    color: var(--ink-3);
    text-align: center;
    min-height: 1.2em;
  }
  .form__note.is-ok {
    color: var(--signal);
  }
  .form__note.is-err {
    color: #ff9b9b;
  }

  @media (max-width: 900px) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form');
  const note = document.getElementById('form-note');
  const label = form?.querySelector('.form__label');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!note) return;
    note.className = 'form__note';

    const data = Object.fromEntries(new FormData(form).entries());
    let invalid = false;
    ['name', 'email', 'message'].forEach((k) => {
      const el = form.querySelector(`[name="${k}"]`);
      const bad = !String(data[k] || '').trim() || (k === 'email' && !/^\S+@\S+\.\S+$/.test(String(data.email)));
      el?.setAttribute('aria-invalid', String(bad));
      if (bad) invalid = true;
    });
    if (invalid) {
      note.textContent = 'Please add your name, a valid email and a short brief.';
      note.classList.add('is-err');
      return;
    }

    if (label) label.textContent = 'Sending…';
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error('bad status');
      note.textContent = 'Received. An engineer will reply within one business day.';
      note.classList.add('is-ok');
      form.reset();
    } catch {
      const body = encodeURIComponent(
        `Name: ${data.name}\nEmail: ${data.email}\nTopic: ${data.topic}\n\n${data.message}`
      );
      window.location.href = `mailto:support@bitsserver.com?subject=${encodeURIComponent('Project enquiry — ' + data.topic)}&body=${body}`;
      note.textContent = 'Opening your email client so nothing gets lost.';
      note.classList.add('is-ok');
    } finally {
      if (label) label.textContent = 'Send enquiry';
    }
  });
</script>
