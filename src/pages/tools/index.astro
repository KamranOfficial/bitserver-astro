<!-- Inline, blocking, and intentionally tiny: sets the saved theme before CSS
     paints so a manual Light/Dark choice never flashes the wrong theme for a
     frame. Mirrors the "bitsserver-theme" logic in js/main.js. -->
<script>(function(){try{var t=localStorage.getItem('bitsserver-theme');if(t==='light'||t==='dark'){document.documentElement.setAttribute('data-theme',t);}}catch(e){}})();</script>
