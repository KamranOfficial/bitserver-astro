---
import Legal from '../../layouts/Legal.astro';
import { LEGAL_PAGES, LEGAL_UPDATED, CONTACT } from '../../data/legal.js';
---

<Legal
  title="Legal Center"
  lead="Every policy that governs your use of BitsServer IT Lab's website and services, all in one place."
  slug="index"
  updated={LEGAL_UPDATED}
>
  <div class="hub">
    {
      LEGAL_PAGES.map((p) => (
        <a class="hub__card" href={`/legal/${p.slug}.html`}>
          <span class="hub__num mono">{p.num}</span>
          <h2>{p.title}</h2>
          <p>{p.blurb}</p>
          <span class="hub__go mono">
            Read <span aria-hidden="true">→</span>
          </span>
        </a>
      ))
    }
  </div>

  <div class="hub__note">
    <p>
      Questions about any of these policies? Write to
      <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a> and our team will get back to you within
      one business day.
    </p>
  </div>
</Legal>

<style>
  .hub {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .hub__card {
    position: relative;
    display: block;
    text-decoration: none;
    padding: 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(160deg, rgba(17, 26, 45, 0.7), rgba(7, 11, 20, 0.5));
    overflow: hidden;
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .hub__card::after {
    content: '';
    position: absolute;
    inset: auto -30% -60% auto;
    width: 180px;
    height: 180px;
    background: radial-gradient(closest-side, rgba(60, 231, 196, 0.22), transparent 70%);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }
  .hub__card:hover {
    border-color: var(--line-strong);
    transform: translateY(-3px);
  }
  .hub__card:hover::after {
    opacity: 1;
  }
  .hub__num {
    font-size: var(--text-xs);
    color: var(--signal-dim);
    letter-spacing: 0.14em;
  }
  .hub__card h2 {
    font-size: var(--text-base) !important;
    margin: 0.6rem 0 0.4rem !important;
  }
  .hub__card p {
    font-size: var(--text-sm);
    color: var(--ink-3);
    margin: 0 0 1rem;
    line-height: 1.6;
  }
  .hub__go {
    font-size: var(--text-xs);
    color: var(--signal);
    letter-spacing: 0.08em;
  }
  .hub__note {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .hub__note p {
    font-size: var(--text-sm);
    color: var(--ink-3);
    margin: 0;
  }
</style>
