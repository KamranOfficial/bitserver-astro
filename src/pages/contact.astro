---
import Base from '../layouts/Base.astro';
import { CONTACT } from '../data/legal.js';

const channels = [
  {
    num: '01',
    title: 'WhatsApp',
    body: 'The fastest way to reach us. Send a message and a real engineer picks it up.',
    action: CONTACT.phone,
    href: CONTACT.whatsapp,
    external: true,
  },
  {
    num: '02',
    title: 'Email',
    body: 'For project briefs, quotes and anything that needs an attachment.',
    action: CONTACT.email,
    href: `mailto:${CONTACT.email}`,
  },
  {
    num: '03',
    title: 'Phone',
    body: 'Prefer to talk it through? Call us during business hours.',
    action: CONTACT.phone,
    href: `tel:${CONTACT.phoneRaw}`,
  },
];

const offices = [
  { city: 'Multan, Pakistan', role: 'Headquarters', tz: 'UTC+5' },
  { city: 'Abu Dhabi, UAE', role: 'Zonal office', tz: 'UTC+4' },
];
---

<Base
  title="Contact — BitsServer IT Lab"
  description="Talk to BitsServer IT Lab about AI automation, cloud infrastructure, VPS hosting, development or cybersecurity. WhatsApp +971 50 715 5863 or support@bitsserver.com."
>
  <section class="chero">
    <canvas id="comms-canvas" aria-hidden="true"></canvas>
    <div class="chero__scrim" aria-hidden="true"></div>
    <div class="wrap chero__content">
      <span class="eyebrow">Get in touch</span>
      <h1 class="chero__title">
        <span class="line">Let's build something</span>
        <span class="line grad">exceptional.</span>
      </h1>
      <p class="lede">
        Have a project in mind or a question about our services? Tell us what you're building and
        we'll route it to the right engineer — typically within one business day.
      </p>
      <div class="chero__cta">
        <a class="btn btn--primary" href={CONTACT.whatsapp} rel="noopener" target="_blank">
          Message us on WhatsApp
        </a>
        <a class="btn btn--ghost" href="#send">Send a brief</a>
      </div>
      <p class="chero__quick mono">
        <span class="pulse" aria-hidden="true"></span>
        {CONTACT.hours}
      </p>
    </div>
  </section>

  <section class="section channels">
    <div class="wrap">
      <div class="channels__grid">
        {
          channels.map((c) => (
            <a
              class="chan"
              href={c.href}
              rel={c.external ? 'noopener' : undefined}
              target={c.external ? '_blank' : undefined}
            >
              <span class="chan__num mono">{c.num}</span>
              <h2>{c.title}</h2>
              <p>{c.body}</p>
              <span class="chan__action mono">
                {c.action} <span aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section send" id="send">
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="wrap send__grid">
      <div class="send__copy">
        <span class="eyebrow" data-reveal>Send a message</span>
        <h2 class="send__title" data-reveal>Tell us about your project.</h2>
        <p class="lede" data-reveal>
          Whether you're exploring AI automation, need cloud infrastructure, or want a hand with
          cybersecurity — our team is ready to help.
        </p>

        <ul class="offices" data-reveal>
          {
            offices.map((o) => (
              <li>
                <span class="mono">{o.role}</span>
                <strong>{o.city}</strong>
                <em>{o.tz}</em>
              </li>
            ))
          }
        </ul>

        <div class="socials" data-reveal>
          <span class="mono socials__h">Follow us</span>
          <div class="socials__row">
            {
              CONTACT.socials.map((s) => (
                <a href={s.href} rel="noopener" target="_blank">
                  {s.label}
                </a>
              ))
            }
          </div>
        </div>
      </div>

      <form class="form panel" id="page-form" data-reveal novalidate>
        <div class="row">
          <label>
            <span>Full name</span>
            <input type="text" name="name" required autocomplete="name" placeholder="Your name" />
          </label>
          <label>
            <span>Email</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="you@company.com"
            />
          </label>
        </div>

        <div class="row">
          <label>
            <span>Phone (optional)</span>
            <input type="tel" name="phone" autocomplete="tel" placeholder="+971 …" />
          </label>
          <label>
            <span>What do you need?</span>
            <select name="topic">
              <option>AI automation</option>
              <option>Cloud migration</option>
              <option>VPS hosting</option>
              <option>Web or mobile build</option>
              <option>Cybersecurity review</option>
              <option>Networking</option>
              <option>IT consulting</option>
              <option>Something else</option>
            </select>
          </label>
        </div>

        <label>
          <span>Message</span>
          <textarea
            name="message"
            rows="5"
            required
            placeholder="Stack, timeline, what success looks like…"></textarea>
        </label>

        <div class="form__actions">
          <button type="submit" class="btn btn--primary form__submit">
            <span class="form__label">Send message</span>
            <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M2 8h11M9 4l4 4-4 4"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
          <button type="button" class="btn btn--ghost" id="wa-send">Send via WhatsApp</button>
        </div>

        <p class="form__note" id="page-note" role="status" aria-live="polite">
          Replies within one business day. No mailing list, ever.
        </p>
      </form>
    </div>
  </section>
</Base>

<style>
  .chero {
    position: relative;
    min-height: 78vh;
    display: flex;
    align-items: center;
    padding-block: clamp(8rem, 14vw, 11rem) clamp(3rem, 7vw, 6rem);
    overflow: hidden;
  }
  #comms-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .chero__scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 70% at 22% 55%, rgba(4, 7, 13, 0.9), transparent 72%),
      linear-gradient(180deg, rgba(4, 7, 13, 0.75) 0%, transparent 38%, rgba(4, 7, 13, 0.85) 100%);
    pointer-events: none;
  }
  .chero__content {
    position: relative;
  }
  .chero__title {
    font-size: var(--text-3xl);
    letter-spacing: -0.03em;
    line-height: 0.98;
    margin: 1rem 0 1.2rem;
  }
  .chero__title .line {
    display: block;
  }
  .grad {
    background: linear-gradient(100deg, var(--signal), var(--violet));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .chero .lede {
    max-width: 54ch;
  }
  .chero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }
  .chero__quick {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.6rem;
    font-size: var(--text-xs);
    color: var(--ink-3);
    letter-spacing: 0.06em;
  }
  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 10px var(--signal);
  }

  .channels {
    padding-block: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--line);
    background: var(--bg-1);
  }
  .channels__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
  }
  .chan {
    position: relative;
    display: block;
    padding: 1.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(160deg, rgba(17, 26, 45, 0.75), rgba(7, 11, 20, 0.55));
    overflow: hidden;
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease);
  }
  .chan::after {
    content: '';
    position: absolute;
    inset: auto -25% -55% auto;
    width: 190px;
    height: 190px;
    background: radial-gradient(closest-side, rgba(60, 231, 196, 0.2), transparent 70%);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }
  .chan:hover {
    border-color: var(--line-strong);
    transform: translateY(-4px);
  }
  .chan:hover::after {
    opacity: 1;
  }
  .chan__num {
    font-size: var(--text-xs);
    color: var(--signal-dim);
    letter-spacing: 0.14em;
  }
  .chan h2 {
    font-size: var(--text-lg);
    margin: 0.6rem 0 0.5rem;
  }
  .chan p {
    color: var(--ink-3);
    font-size: var(--text-sm);
    line-height: 1.65;
    margin-bottom: 1.1rem;
  }
  .chan__action {
    font-size: var(--text-xs);
    color: var(--signal);
    letter-spacing: 0.05em;
  }

  .send {
    position: relative;
    background: radial-gradient(ellipse 70% 60% at 50% 0%, rgba(139, 108, 255, 0.08), transparent 60%), var(--bg);
    overflow: hidden;
  }
  .send__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .send__title {
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
    margin: 1rem 0 1rem;
  }
  .offices {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: grid;
    gap: 1rem;
  }
  .offices li {
    display: grid;
    gap: 0.15rem;
    padding-left: 1rem;
    border-left: 2px solid var(--signal-dim);
  }
  .offices span {
    font-size: var(--text-xs);
    color: var(--ink-3);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .offices strong {
    font-size: var(--text-base);
  }
  .offices em {
    font-style: normal;
    font-size: var(--text-sm);
    color: var(--ink-3);
  }
  .socials {
    margin-top: 2rem;
  }
  .socials__h {
    display: block;
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.7rem;
  }
  .socials__row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .socials__row a {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: var(--text-sm);
    color: var(--ink-2);
    transition: all 0.25s var(--ease);
  }
  .socials__row a:hover {
    color: var(--signal);
    border-color: var(--signal-dim);
  }

  .form {
    padding: clamp(1.3rem, 3vw, 2.2rem);
    display: grid;
    gap: 1rem;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .form label {
    display: grid;
    gap: 0.4rem;
  }
  .form label > span {
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
    font-family: var(--font-mono);
  }
  .form input,
  .form select,
  .form textarea {
    width: 100%;
    padding: 0.75rem 0.9rem;
    background: rgba(4, 7, 13, 0.6);
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--ink);
    font: inherit;
    font-size: var(--text-sm);
    transition: border-color 0.25s, box-shadow 0.25s;
  }
  .form textarea {
    resize: vertical;
  }
  .form input:focus,
  .form select:focus,
  .form textarea:focus {
    outline: none;
    border-color: var(--signal-dim);
    box-shadow: 0 0 0 3px rgba(60, 231, 196, 0.14);
  }
  .form [aria-invalid='true'] {
    border-color: #ff6b6b;
  }
  .form__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 0.3rem;
  }
  .form__note {
    font-size: var(--text-xs);
    color: var(--ink-3);
    margin: 0;
  }
  .form__note.is-ok {
    color: var(--signal);
  }
  .form__note.is-err {
    color: #ff8f8f;
  }

  @media (max-width: 900px) {
    .send__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 720px) {
    .chero__scrim {
      background:
        radial-gradient(ellipse 130% 60% at 50% 45%, rgba(4, 7, 13, 0.9), transparent 78%),
        linear-gradient(180deg, rgba(4, 7, 13, 0.85) 0%, rgba(4, 7, 13, 0.5) 35%, rgba(4, 7, 13, 0.9) 100%);
    }
    .chero__quick {
      font-size: 0.68rem;
    }
  }
  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr;
    }
    .chero__cta .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  import { initComms } from '../scripts/comms3d.js';

  const canvas = document.getElementById('comms-canvas');
  if (canvas) {
    try {
      initComms(canvas);
    } catch {
      canvas.style.display = 'none';
    }
  }

  const WA = 'https://wa.me/971507155863';
  const MAIL = 'support@bitsserver.com';
  const form = document.getElementById('page-form');
  const note = document.getElementById('page-note');
  const label = form?.querySelector('.form__label');

  const collect = () => Object.fromEntries(new FormData(form).entries());

  const validate = (data) => {
    let ok = true;
    ['name', 'email', 'message'].forEach((k) => {
      const el = form.querySelector(`[name="${k}"]`);
      const bad =
        !String(data[k] || '').trim() ||
        (k === 'email' && !/^\S+@\S+\.\S+$/.test(String(data.email)));
      el?.setAttribute('aria-invalid', String(bad));
      if (bad) ok = false;
    });
    if (!ok && note) {
      note.className = 'form__note is-err';
      note.textContent = 'Please add your name, a valid email and a short message.';
    }
    return ok;
  };

  document.getElementById('wa-send')?.addEventListener('click', () => {
    const data = collect();
    if (!validate(data)) return;
    const text = `Hi BitsServer — I'm ${data.name} (${data.email}${data.phone ? ', ' + data.phone : ''}).\nTopic: ${data.topic}\n\n${data.message}`;
    window.open(`${WA}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
    if (note) {
      note.className = 'form__note is-ok';
      note.textContent = 'Opening WhatsApp with your message ready to send.';
    }
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = collect();
    if (!validate(data)) return;
    if (note) note.className = 'form__note';
    if (label) label.textContent = 'Sending…';
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      if (!res.ok) throw new Error('bad status');
      if (note) {
        note.className = 'form__note is-ok';
        note.textContent = 'Received. An engineer will reply within one business day.';
      }
      form.reset();
    } catch {
      const body = encodeURIComponent(
        `Name: ${data.name}\nEmail: ${data.email}\nPhone: ${data.phone || '—'}\nTopic: ${data.topic}\n\n${data.message}`
      );
      window.location.href = `mailto:${MAIL}?subject=${encodeURIComponent('Project enquiry — ' + data.topic)}&body=${body}`;
      if (note) {
        note.className = 'form__note is-ok';
        note.textContent = 'Opening your email client so nothing gets lost.';
      }
    } finally {
      if (label) label.textContent = 'Send message';
    }
  });
</script>
